{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AX 마케팅 자동화",
  "version": "0.1.0",
  "identifier": "com.skbroadband.ax-marketing",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AX 마케팅 자동화",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "PUBKEY_PLACEHOLDER_REPLACE_AFTER_KEYGEN",
      "endpoints": [
        "https://github.com/iamunjoa-prog/AXMarketingwindowapp/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "SK Broadband",
    "copyright": "SK Broadband",
    "shortDescription": "B tv 마케팅 캠페인 기획 자동화",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
